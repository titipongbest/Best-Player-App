<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Receives taps and swipe gestures over the video. -->
    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/gesture_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_info"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_seek_mode"
                style="@style/PlayerChip"
                android:text="@string/seek_exact" />

            <TextView
                android:id="@+id/btn_speed"
                style="@style/PlayerChip"
                android:text="1.0x" />

            <ImageButton
                android:id="@+id/btn_aspect"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/aspect"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/btn_rotate"
                style="@style/PlayerIconButton"
                android:contentDescription="@string/rotate"
                android:src="@drawable/ic_rotate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="32dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:minWidth="56dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="#66FFFFFF"
                    android:progressTint="@color/accent"
                    android:secondaryProgressTint="#99FFFFFF"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:minWidth="56dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_prev_frame"
                    style="@style/PlayerIconButton"
                    android:contentDescription="@string/prev_frame"
                    android:src="@drawable/ic_prev_frame" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    style="@style/PlayerIconButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/play_pause"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/btn_next_frame"
                    style="@style/PlayerIconButton"
                    android:contentDescription="@string/next_frame"
                    android:src="@drawable/ic_next_frame" />
            </LinearLayout>
        </LinearLayout>

        <!-- Capture frame: always reachable on the right edge, like MX Player. -->
        <ImageButton
            android:id="@+id/btn_capture"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_capture"
            android:contentDescription="@string/capture_frame"
            android:elevation="4dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            app:tint="@android:color/white" />
    </FrameLayout>
</FrameLayout>
